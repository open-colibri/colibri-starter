{
    "name": "opencolibri/starter-themes",
    "description": "Ready-to-use Sylius storefront themes (Canvas, Blush, Prompt, Volt, Lagoon, Aurora, Tech, Retro Gaming, Drive, Cellar, Roastery, Teahouse, Summit, Groove, Arena, Hearth, Bloom, Paws, Culture, Depot, Torque) installable with Castor",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/opencolibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "opencolibri/starter-core": "self.version",
        "nikic/php-parser": "^5.0",
        "castor-php/docker": "^0.10"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\Themes\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\Themes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
