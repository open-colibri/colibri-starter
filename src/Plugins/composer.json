{
    "name": "open-colibri/starter-plugins",
    "description": "Castor tasks to add and remove Sylius plugins (CMS, Invoicing, Refund, Wishlist, reCAPTCHA, ALTCHA...)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/open-colibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "open-colibri/starter-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\Plugins\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\Plugins\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
