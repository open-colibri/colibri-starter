{
    "name": "open-colibri/starter-datasets",
    "description": "Ready-made demo datasets (products, collections and their images) for the Colibri Starter import package",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/open-colibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "open-colibri/starter-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\Datasets\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\Datasets\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
