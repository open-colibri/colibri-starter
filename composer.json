{
    "name": "open-colibri/starter",
    "description": "Colibri Starter: Castor tooling to bootstrap and customize Sylius applications (monorepo of all open-colibri/starter-* packages)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/open-colibri/colibri-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "castor-php/docker": "^0.10",
        "nikic/php-parser": "^5.0",
        "symfony/ai-ollama-platform": "^0.12.0",
        "symfony/ai-open-router-platform": "^0.12.0",
        "symfony/ai-platform": "^0.12.0",
        "symfony/dotenv": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/process": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "require-dev": {
        "jolicode/castor": "^1.6",
        "phpunit/phpunit": "^13.2"
    },
    "replace": {
        "open-colibri/starter-core": "self.version",
        "open-colibri/starter-datasets": "self.version",
        "open-colibri/starter-import": "self.version",
        "open-colibri/starter-menu": "self.version",
        "open-colibri/starter-plugins": "self.version",
        "open-colibri/starter-themes": "self.version",
        "open-colibri/starter-upsun": "self.version"
    },
    "suggest": {
        "jolicode/castor-api": "Expose import tasks over HTTP"
    },
    "autoload": {
        "psr-4": {
            "OpenColibri\\Starter\\Core\\": "src/Core/src/",
            "OpenColibri\\Starter\\Datasets\\": "src/Datasets/src/",
            "OpenColibri\\Starter\\Import\\": "src/Import/src/",
            "OpenColibri\\Starter\\Menu\\": "src/Menu/src/",
            "OpenColibri\\Starter\\Plugins\\": "src/Plugins/src/",
            "OpenColibri\\Starter\\Themes\\": "src/Themes/src/",
            "OpenColibri\\Starter\\Upsun\\": "src/Upsun/src/"
        },
        "files": [
            "src/Core/src/Installer/functions.php",
            "src/Datasets/src/functions.php",
            "src/Import/src/constants.php",
            "src/Import/src/ImportContext.php",
            "src/Import/src/ImportBootstrap.php",
            "src/Import/src/bootstrap.php",
            "src/Import/src/functions.php",
            "src/Menu/src/functions.php",
            "src/Plugins/src/functions.php",
            "src/Themes/src/functions.php",
            "src/Upsun/src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenColibri\\Starter\\Core\\Tests\\": "src/Core/tests/",
            "OpenColibri\\Starter\\Datasets\\Tests\\": "src/Datasets/tests/",
            "OpenColibri\\Starter\\Import\\Tests\\": "src/Import/tests/",
            "OpenColibri\\Starter\\Menu\\Tests\\": "src/Menu/tests/",
            "OpenColibri\\Starter\\Plugins\\Tests\\": "src/Plugins/tests/",
            "OpenColibri\\Starter\\Themes\\Tests\\": "src/Themes/tests/",
            "OpenColibri\\Starter\\Upsun\\Tests\\": "src/Upsun/tests/",
            "OpenColibri\\Starter\\Tests\\": "tests/",
            "OpenColibri\\Starter\\Monorepo\\": ".castor/monorepo/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
